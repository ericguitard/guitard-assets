# MIME types and cache policy for assets.guitard.ca

# Stable icon filenames revalidate daily while shared caches may retain them.
/*.jpg
  Content-Type: image/jpeg
  Cache-Control: public, max-age=86400, s-maxage=2592000, stale-while-revalidate=604800, stale-if-error=2592000

/*.png
  Content-Type: image/png
  Cache-Control: public, max-age=86400, s-maxage=2592000, stale-while-revalidate=604800, stale-if-error=2592000

/*.svg
  Content-Type: image/svg+xml; charset=utf-8
  Cache-Control: public, max-age=86400, s-maxage=2592000, stale-while-revalidate=604800, stale-if-error=2592000

/favicon.ico
  Content-Type: image/vnd.microsoft.icon
  Cache-Control: public, max-age=86400, s-maxage=2592000, stale-while-revalidate=604800, stale-if-error=2592000

# Public metadata and discovery files.
/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=86400
